# Secrets uniquement. Tout ce qui décrit le lieu (position, altitude, fuseau,
# identifiants de station, nom de l'instance) vit dans almanach.config.json,
# committé dans le dépôt.

# Tempest — jeton perso depuis Settings → Data Authorizations
WEATHERFLOW_TOKEN=

# Anthropic — pour la synthèse du billet
ANTHROPIC_API_KEY=

# --- Surcharges optionnelles ---------------------------------------------
# Chacune de ces variables, si définie, l'emporte sur almanach.config.json.
# Utile en CI ou pour un essai ponctuel ; en régime normal, laisser vide et
# éditer la config.
#
# WEATHERFLOW_STATION_ID=
# BIRDWEATHER_STATION_ID=   (lecture publique : aucun jeton requis)
# OBS_LAT=
# OBS_LON=
# OBS_ELEV_M=
# TZ=

# Open-Meteo — couverture nuageuse uniquement (pas de clé). Défaut OK.
OPENMETEO_BASE=https://api.open-meteo.com/v1

# NOAA SWPC — aurores. Défaut OK.
NOAA_SWPC_BASE=https://services.swpc.noaa.gov
